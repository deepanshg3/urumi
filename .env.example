# Copy to `.env` and fill in values. Never commit `.env`.
# All secrets are supplied through environment variables (or a secret manager in production).

# --- LLM / Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_REQUEST_TIMEOUT_SECONDS=30

# --- LangSmith tracing (optional; disable by setting LANGSMITH_TRACING=false) ---
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=urumi-mcp-gateway
LANGSMITH_ENDPOINT=

# --- Chat agent ---
# The agent talks to the gateway as an MCP client; all authorization is still
# enforced by the gateway on every tool call.
AGENT_HOST=0.0.0.0
AGENT_PORT=8200
AGENT_GATEWAY_MCP_URL=http://localhost:8000/mcp
AGENT_GATEWAY_TIMEOUT_SECONDS=20
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_MESSAGE_CHARS=8000
AGENT_TOOL_REFRESH_SECONDS=30
AGENT_TIMEZONE=UTC
AGENT_SYSTEM_PROMPT_PATH=config/prompts/chat_agent.txt
AGENT_EPHEMERAL_KEY_TTL_SECONDS=180
AGENT_CONVERSATION_MAX_MESSAGES=200
AGENT_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Gateway database ---
# Local development:  sqlite+aiosqlite:///./data/gateway.db
# PostgreSQL later:    postgresql+psycopg://user:password@host:5432/gateway
DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db

# --- WooCommerce REST API (server-side upstream credentials; never exposed to clients or the LLM) ---
# Run `./scripts/store_setup.sh` to start a local store and fill these in automatically.
WOOCOMMERCE_BASE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_your_consumer_key
WOOCOMMERCE_CONSUMER_SECRET=cs_your_consumer_secret
# auto: Basic over HTTPS, OAuth 1.0a otherwise. WooCommerce 11+ only accepts
# Basic auth over HTTPS, so a plain-HTTP local store must use oauth1.
WOOCOMMERCE_AUTH_MODE=auto
# Only needed when the request Host differs from WordPress home_url (e.g. Docker).
WOOCOMMERCE_SIGNING_BASE_URL=
WOOCOMMERCE_TIMEOUT_SECONDS=10
WOOCOMMERCE_DEFAULT_PAGE_SIZE=20
WOOCOMMERCE_MAX_PAGE_SIZE=100
WOOCOMMERCE_MAX_RETRIES=2
WOOCOMMERCE_RETRY_BACKOFF_SECONDS=0.5

# --- MCP servers (Streamable HTTP) ---
# Each server reads its own variables, falling back to MCP_HOST/MCP_PORT.
WOOCOMMERCE_MCP_HOST=127.0.0.1
WOOCOMMERCE_MCP_PORT=8101
WOOCOMMERCE_MCP_PATH=/mcp
INVENTORY_MCP_HOST=127.0.0.1
INVENTORY_MCP_PORT=8102
INVENTORY_MCP_PATH=/mcp
SHIPPING_MCP_HOST=127.0.0.1
SHIPPING_MCP_PORT=8103
SHIPPING_MCP_PATH=/mcp
MCP_STATELESS_HTTP=true
MCP_JSON_RESPONSE=true
# Streamable HTTP DNS-rebinding protection. Loopback defaults apply when the
# server binds to 127.0.0.1; container deployments must list their hostnames.
MCP_ENABLE_DNS_REBINDING_PROTECTION=true
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
LOG_LEVEL=INFO

# --- Inventory defaults ---
INVENTORY_LOW_STOCK_THRESHOLD=5
INVENTORY_SUMMARY_MAX_PRODUCTS=1000
INVENTORY_SUMMARY_SCAN_PAGE_SIZE=100

# --- Shipping mock provider behavior ---
# simulated: always succeed | degraded: fail randomly | failing: always fail
SHIPPING_MOCK_MODE=simulated
SHIPPING_MOCK_FAILURE_RATE=0.0
SHIPPING_DEFAULT_CARRIER=mock-carrier
SHIPPING_TRACKING_PREFIX=MOCK
SHIPPING_DELIVERY_DAYS_MIN=2
SHIPPING_DELIVERY_DAYS_MAX=7
# Shipping keeps its own database, separate from the gateway database.
SHIPPING_DATABASE_URL=sqlite+aiosqlite:///./data/shipping.db
SHIPPING_ALLOW_MULTIPLE_PER_ORDER=false
SHIPPING_TIMEOUT_SECONDS=10
SHIPPING_MAX_RETRIES=1

# --- Gateway HTTP bind (optional overrides) ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# --- Gateway auth / identity ---
# Required before storing upstream credentials; must be >= 16 characters and
# stable across restarts (rotating it makes stored credentials unreadable).
GATEWAY_SECRET_KEY=replace-with-a-long-random-value
GATEWAY_SESSION_TTL_MINUTES=720
GATEWAY_COOKIE_SECURE=false
# Create the first administrator by setting both, then running:
#   .venv/bin/python -m services.gateway.bootstrap
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Comma-separated origins allowed to call the management API from a browser.
GATEWAY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Assessment demo mode (disabled by default) ---
# No-login persona switching for local assessments. Enabling it requires both
# flags below and a loopback/local request (or an explicit origin allowlist).
# Never enable this in production: the gateway refuses to start when
# GATEWAY_DEPLOYMENT_ENV is production/prod.
GATEWAY_DEMO_MODE=false
GATEWAY_DEMO_ACK=false
GATEWAY_DEPLOYMENT_ENV=development
GATEWAY_DEMO_ALLOW_REMOTE=false
# Extra browser origins allowed to start a demo persona session.
GATEWAY_DEMO_ORIGINS=
# DNS-rebinding protection for the gateway's own /mcp endpoint. Loopback
# defaults apply when the gateway binds to 127.0.0.1.
GATEWAY_ENABLE_DNS_REBINDING_PROTECTION=true
GATEWAY_ALLOWED_HOSTS=
GATEWAY_ALLOWED_ORIGINS=

# --- Gateway discovery / upstream safety ---
GATEWAY_UPSTREAM_TIMEOUT_SECONDS=15
GATEWAY_DISCOVERY_TIMEOUT_SECONDS=10
GATEWAY_UPSTREAM_RETRIES=1
# Re-discover upstream tools periodically (seconds; 0 disables). Keeps the
# tool list self-healing when an upstream restarts.
GATEWAY_REFRESH_INTERVAL_SECONDS=60
# SSRF allowlist. Public upstreams additionally require
# GATEWAY_ALLOW_PUBLIC_UPSTREAMS=true and may never resolve to private,
# loopback, link-local or cloud-metadata addresses.
GATEWAY_ALLOWED_UPSTREAM_HOSTS=127.0.0.1,localhost,::1,host.docker.internal,woocommerce-mcp,inventory-mcp,shipping-mcp,gateway
GATEWAY_ALLOW_PUBLIC_UPSTREAMS=false
GATEWAY_AUDIT_ENABLED=true
