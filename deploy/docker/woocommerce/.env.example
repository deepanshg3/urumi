# Local development store configuration. Copy to `.env` in this directory:
#   cp deploy/docker/woocommerce/.env.example deploy/docker/woocommerce/.env
#
# These are LOCAL DEVELOPMENT credentials only. They are not real secrets and
# are never valid outside a developer machine. `.env` is gitignored.

# Host port for the storefront and WP admin (http://localhost:8080).
STORE_PORT=8080

# WordPress admin account created by scripts/store_setup.sh.
STORE_ADMIN_USER=admin
STORE_ADMIN_PASSWORD=urumi_dev_admin_password
STORE_ADMIN_EMAIL=admin@example.test
STORE_TITLE="Urumi Local Store"
STORE_URL=http://localhost:8080

# MariaDB (local development only).
STORE_DB_NAME=wordpress
STORE_DB_USER=wordpress
STORE_DB_PASSWORD=urumi_dev_db_password
STORE_DB_ROOT_PASSWORD=urumi_dev_db_root_password
